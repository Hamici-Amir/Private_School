# Environment configuration
# Copy this file to `.env.local` and adjust values as needed.
# Never commit real `.env` files - they contain no secrets today, but will later.

# Base URL of the future backend API.
# Leave empty to target the same origin (useful behind a proxy).
VITE_API_BASE_URL=

# Per-request timeout in milliseconds.
VITE_API_TIMEOUT=15000

# Data source switch:
#   true  -> the service layer resolves from the mock layer
#   false -> the service layer calls the real API (requires a backend)
VITE_USE_MOCK_API=true

# Developer conveniences (React Query DevTools, verbose logging, ...).
VITE_ENABLE_DEV_TOOLS=false